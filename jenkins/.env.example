# Copie para jenkins/.env se quiser trocar o usuario/senha padrao do Jenkins
# local (admin/admin). O docker compose le esse arquivo automaticamente.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# Pasta pai dos 3 repositorios (gameeducator-backend, -frontend, -automation).
# Padrao: a pasta acima do repositorio backend.
